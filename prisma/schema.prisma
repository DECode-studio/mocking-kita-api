datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Project {
  id          String    @id @default(uuid())
  name        String
  description String?
  status      Boolean   @default(true)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  pics         ProjectPic[]
  environments Environment[]
  collections  Collection[]
  apis         Api[]
  scenarioFlows ScenarioFlow[]
  dataSheets   DataSheet[]

  @@map("tblProject")
}

enum EnvironmentType {
  LOCAL
  DEVELOPMENT
  TESTING
  STAGING
  PRODUCTION
}

model Environment {
  id              String          @id @default(uuid())
  projectId       String          @map("project_id")
  name            String
  environmentType EnvironmentType @default(LOCAL) @map("environment_type")
  baseUrl         String?         @map("base_url")
  status          Boolean         @default(true)
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  deletedAt       DateTime?       @map("deleted_at")

  project                Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  apiEnvironments        ApiEnvironment[]
  scenarioFlows          ScenarioFlow[]
  scenarioFlowExecutions ScenarioFlowExecution[]

  @@map("tblEnvironment")
}

model Collection {
  id          String    @id @default(uuid())
  projectId   String    @map("project_id")
  name        String
  description String?
  status      Boolean   @default(true)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  apis    Api[]

  @@map("tblCollection")
}

model Api {
  id            String    @id @default(uuid())
  projectId     String    @map("project_id")
  collectionId  String?   @map("collection_id")
  name          String
  description   String?
  path          String
  methodRequest String    @map("method_request")
  status        Boolean   @default(true)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  project           Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  collection        Collection?        @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  pics              ApiPic[]
  apiEnvironments   ApiEnvironment[]
  requestScenarios  RequestScenario[]
  scenarioFlowSteps ScenarioFlowStep[]

  @@unique([projectId, path, methodRequest], name: "tblApi_index_0")
  @@map("tblApi")
}

model ProjectPic {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  accountId String   @map("account_id")
  createdAt DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([projectId, accountId])
  @@map("tblProjectPic")
}

model ApiPic {
  id        String   @id @default(uuid())
  apiId     String   @map("api_id")
  accountId String   @map("account_id")
  createdAt DateTime @default(now()) @map("created_at")

  api     Api     @relation(fields: [apiId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([apiId, accountId])
  @@map("tblApiPic")
}

model ApiEnvironment {
  id            String   @id @default(uuid())
  apiId         String   @map("api_id")
  environmentId String   @map("environment_id")
  enabled       Boolean  @default(true)
  pathOverride  String?  @map("path_override")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  api         Api         @relation(fields: [apiId], references: [id], onDelete: Cascade)
  environment Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)

  @@unique([apiId, environmentId], name: "tblApiEnvironment_index_1")
  @@map("tblApiEnvironment")
}

model RequestScenario {
  id          String    @id @default(uuid())
  apiId       String    @map("api_id")
  name        String
  description String?
  headers     Json?
  queryParams Json?     @map("query_params")
  pathParams  Json?     @map("path_params")
  body        Json?
  bodyType      String    @default("JSON") @map("body_type")
  matchType     String    @default("EXACT") @map("match_type")
  matchStrategy String    @default("ALL") @map("match_strategy")
  bodyRules           Json?     @map("body_rules")
  strictBodyStructure Boolean   @default(true) @map("strict_body_structure")
  priority            Int       @default(0)
  status        Boolean   @default(true)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  api               Api                @relation(fields: [apiId], references: [id], onDelete: Cascade)
  responseScenarios ResponseScenario[]
  scenarioFlowSteps ScenarioFlowStep[]

  @@map("tblRequestScenario")
}

model ResponseScenario {
  id                String    @id @default(uuid())
  requestScenarioId String    @map("request_scenario_id")
  name              String
  description       String?
  statusCode        Int?      @map("status_code")
  headers           Json?
  body              Json?
  responseType      String    @default("JSON") @map("response_type")
  filePath          String?   @map("file_path")
  fileName          String?   @map("file_name")
  delayMs           Int       @default(0) @map("delay_ms")
  weight            Int       @default(100)
  priority          Int       @default(0)
  status            Boolean   @default(true)
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  requestScenario RequestScenario @relation(fields: [requestScenarioId], references: [id], onDelete: Cascade)

  @@map("tblResponseScenario")
}

model ScenarioFlow {
  id                   String    @id @default(uuid())
  projectId            String?   @map("project_id")
  name                 String
  description          String?
  status               Boolean   @default(true)
  defaultEnvironmentId String?   @map("default_environment_id")
  stopOnFailure        Boolean   @default(true) @map("stop_on_failure")
  variables            Json?
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  deletedAt            DateTime? @map("deleted_at")

  project            Project?                @relation(fields: [projectId], references: [id], onDelete: SetNull)
  defaultEnvironment Environment?            @relation(fields: [defaultEnvironmentId], references: [id], onDelete: SetNull)
  steps              ScenarioFlowStep[]
  executions         ScenarioFlowExecution[]

  @@index([projectId])
  @@map("tblScenarioFlow")
}

model ScenarioFlowStep {
  id                  String    @id @default(uuid())
  flowId              String    @map("flow_id")
  apiId               String?   @map("api_id")
  requestScenarioId   String?   @map("request_scenario_id")
  stepOrder           Int       @map("step_order")
  name                String
  description         String?
  enabled             Boolean   @default(true)
  delayMs             Int       @default(0) @map("delay_ms")
  continueOnError     Boolean   @default(false) @map("continue_on_error")
  methodOverride      String?   @map("method_override")
  pathOverride        String?   @map("path_override")
  headersOverride     Json?     @map("headers_override")
  queryParamsOverride Json?     @map("query_params_override")
  pathParamsOverride  Json?     @map("path_params_override")
  bodyOverride        Json?     @map("body_override")
  extractors          Json?
  assertions          Json?
  targetEnvironmentType String?  @default("DEFAULT") @map("target_environment_type")
  targetEnvironment     String?  @map("target_environment")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  flow           ScenarioFlow                @relation(fields: [flowId], references: [id], onDelete: Cascade)
  api            Api?                        @relation(fields: [apiId], references: [id], onDelete: SetNull)
  requestScenario RequestScenario?           @relation(fields: [requestScenarioId], references: [id], onDelete: SetNull)
  executionSteps ScenarioFlowExecutionStep[]

  @@index([flowId, stepOrder])
  @@map("tblScenarioFlowStep")
}

model ScenarioFlowExecution {
  id               String    @id @default(uuid())
  flowId           String    @map("flow_id")
  environmentId    String?   @map("environment_id")
  status           String    @default("RUNNING")
  triggerSource    String    @default("MANUAL") @map("trigger_source")
  targetMode       String    @default("LIVE") @map("target_mode")
  totalSteps       Int       @default(0) @map("total_steps")
  passedSteps      Int       @default(0) @map("passed_steps")
  failedSteps      Int       @default(0) @map("failed_steps")
  durationMs       Int       @default(0) @map("duration_ms")
  initialVariables Json?     @map("initial_variables")
  finalVariables   Json?     @map("final_variables")
  executedBy       String?   @map("executed_by")
  errorSummary     String?   @map("error_summary")
  createdAt        DateTime  @default(now()) @map("created_at")

  flow        ScenarioFlow                @relation(fields: [flowId], references: [id], onDelete: Cascade)
  environment Environment?                @relation(fields: [environmentId], references: [id], onDelete: SetNull)
  steps       ScenarioFlowExecutionStep[]

  @@index([flowId])
  @@index([createdAt(sort: Desc)])
  @@map("tblScenarioFlowExecution")
}

model ScenarioFlowExecutionStep {
  id                 String    @id @default(uuid())
  executionId        String    @map("execution_id")
  flowStepId         String?   @map("flow_step_id")
  stepOrder          Int       @map("step_order")
  stepName           String    @map("step_name")
  method             String
  url                String
  status             String
  httpStatusCode     Int?      @map("http_status_code")
  durationMs         Int       @default(0) @map("duration_ms")
  requestSnapshot    Json?     @map("request_snapshot")
  responseSnapshot   Json?     @map("response_snapshot")
  extractedVariables Json?     @map("extracted_variables")
  assertionResults   Json?     @map("assertion_results")
  errorMessage       String?   @map("error_message")
  createdAt          DateTime  @default(now()) @map("created_at")

  execution ScenarioFlowExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  flowStep  ScenarioFlowStep?     @relation(fields: [flowStepId], references: [id], onDelete: SetNull)

  @@index([executionId])
  @@map("tblScenarioFlowExecutionStep")
}

model Account {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String
  role      String
  name      String
  googleId          String?  @unique @map("google_id")
  hasCustomPassword Boolean  @default(false) @map("has_custom_password")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  changeLogs  ChangeLog[]
  projectPics ProjectPic[]
  apiPics     ApiPic[]

  @@map("tblAccount")
}

model ChangeLog {
  id          String   @id @default(uuid())
  action      String
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id")
  projectId   String?  @map("project_id")
  userId      String?  @map("user_id")
  operator    String
  description String?
  beforeState Json?    @map("before_state")
  afterState  Json?    @map("after_state")
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  user Account? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([projectId], map: "tblChangeLog_project_id_idx")
  @@index([createdAt(sort: Desc)], map: "tblChangeLog_created_at_idx")
  @@map("tblChangeLog")
}

model DataSheet {
  id          String    @id @default(uuid())
  projectId   String?   @map("project_id")
  name        String
  code        String
  category    String?
  description String?
  format      String    @default("LIST") // "LIST" or "TABLE"
  data        Json      @default("[]")
  status      Boolean   @default(true)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  project     Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([code])
  @@map("tblDataSheet")
}

